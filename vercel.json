{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "frontend": {
            "root": "frontend/",
            "framework": "vite",
            "rewrites": [
                { "source": "/(.*)", "destination": "/index.html" }
            ]
        },
        "backend": {
            "root": "backend/",
            "framework": "express",
            "entrypoint": "server.js",
            "routes": [
                {
                    "src": "/api/(.*)",
                    "transforms": [
                        { "type": "request.path", "op": "set", "args": "/$1" }
                    ]
                }
            ]
        }
    },
    "rewrites": [
        { "source": "/api/(.*)", "destination": { "service": "backend" } },
        { "source": "/(.*)", "destination": { "service": "frontend" } }
    ]
}
